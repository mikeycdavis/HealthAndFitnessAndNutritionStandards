    prompt --> spec
    brief --> spec
    spec -->|"Source: item N"| stds
    spec -->|"verbatim check"| fid
    seriesInv -->|"compare"| inv
    ruleInv -->|"compare"| rul
    stds --> inv
    cat --> rul
